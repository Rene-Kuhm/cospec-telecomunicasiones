# ============================================================
# Cospec Telecomunicaciones — Variables de Entorno
# ============================================================
# Copiar a .env y completar con valores reales.
# NUNCA commitear .env al repositorio.
# Todas las variables con valor "CHANGE_ME" son OBLIGATORIAS.
# ============================================================

# ── APP ──────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_NAME=cospec-api
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true               # false en producción obligatoriamente
APP_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
CORS_ORIGINS=http://localhost:4200,http://localhost:8000
# En producción: CORS_ORIGINS=https://app.cospec-telecom.com

# ── SECURITY ─────────────────────────────────────────────────
# JWT — mínimo 32 caracteres aleatorios. Generar con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_min_32_chars_random_hex
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ── DATABASE (PostgreSQL) ─────────────────────────────────────
# Local (docker-compose): postgresql+asyncpg://cospec:cospec@localhost:5432/cospec_db
# Producción (Neon): postgresql+asyncpg://user:pass@host.neon.tech/cospec_db?sslmode=require
DATABASE_URL=postgresql+asyncpg://cospec:cospec@localhost:5432/cospec_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Alembic usa URL sincrónica (sin +asyncpg)
ALEMBIC_DATABASE_URL=postgresql://cospec:cospec@localhost:5432/cospec_db

# ── REDIS ────────────────────────────────────────────────────
# Local: redis://localhost:6379/0
# Upstash: rediss://default:TOKEN@host.upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# ── OBJECT STORAGE (Cloudflare R2 / MinIO) ───────────────────
# Para MinIO local: endpoint=http://localhost:9000, region=us-east-1
# Para Cloudflare R2: endpoint=https://ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_BUCKET_NAME=cospec
STORAGE_REGION=us-east-1
# En R2: STORAGE_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
# R2_ACCOUNT_ID=CHANGE_ME  # Solo Cloudflare R2

# TTLs de URLs presignadas (en segundos)
STORAGE_DOWNLOAD_URL_TTL_SECONDS=3600      # 1 hora
STORAGE_UPLOAD_URL_TTL_SECONDS=900         # 15 minutos

# ── EMAIL (Brevo / Sendinblue) ────────────────────────────────
# Obtener en: https://app.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=CHANGE_ME
EMAIL_FROM_ADDRESS=no-reply@cospec-telecom.com
EMAIL_FROM_NAME=Cospec Telecomunicaciones
# En desarrollo, usar Mailpit (no envía emails reales):
# OVERRIDE: el código detecta APP_ENV=development y usa Mailpit SMTP
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025

# ── SMS (Brevo) ───────────────────────────────────────────────
# Mismo API Key que email. Sender debe ser aprobado en dashboard Brevo.
SMS_SENDER_NAME=Cospec         # max 11 caracteres, alfanumérico
SMS_ENABLED=true               # false para deshabilitar SMS sin romper código

# ── GEOCODING (Nominatim / OSM) ───────────────────────────────
GEOCODING_PROVIDER=nominatim   # nominatim | google (para futuras extensiones)
NOMINATIM_USER_AGENT=cospec-telecom-api/0.1.0   # OBLIGATORIO por TOS de Nominatim
NOMINATIM_RATE_LIMIT_DELAY=1.1 # segundos entre requests (mínimo 1.0 por TOS)
# Si en futuro se migra a Google:
# GOOGLE_MAPS_API_KEY=CHANGE_ME

# ── TELEGRAM BOT ─────────────────────────────────────────────
# Obtener de @BotFather en Telegram: /newbot
TELEGRAM_BOT_TOKEN=CHANGE_ME          # formato: 123456:ABC-DEFghijklmnop
# Secret para validar webhooks (generar aleatorio, mínimo 32 chars):
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_random_32_chars
# URL pública donde Telegram enviará los updates (requiere HTTPS en producción)
TELEGRAM_WEBHOOK_URL=https://api.cospec-telecom.com/api/v1/integrations/telegram/webhook
# En desarrollo local usar ngrok o similar:
# TELEGRAM_WEBHOOK_URL=https://XXXX.ngrok.io/api/v1/integrations/telegram/webhook
TELEGRAM_ENABLED=false  # true cuando se tengan las credenciales y el webhook esté configurado

# ── WORKERS (ARQ) ────────────────────────────────────────────
ARQ_MAX_JOBS=10                # jobs concurrentes por worker
ARQ_JOB_TIMEOUT=300            # segundos antes de abortar un job
ARQ_QUEUE_NAME=cospec_queue

# ── RATE LIMITING ────────────────────────────────────────────
RATE_LIMIT_LOGIN_PER_MINUTE=10           # por IP
RATE_LIMIT_REGISTER_PER_MINUTE=5         # por IP
RATE_LIMIT_API_PER_MINUTE=100            # por usuario autenticado

# ── EXPORT (openpyxl) ─────────────────────────────────────────
EXPORT_MAX_ROWS=50000           # máximo de filas por export
EXPORT_FILE_TTL_DAYS=30         # días que se conservan los archivos en storage

# ── ATTACHMENTS ───────────────────────────────────────────────
ATTACHMENT_MAX_SIZE_MB=20
ATTACHMENT_MAX_PER_TICKET=10
ATTACHMENT_ALLOWED_TYPES=image/jpeg,image/png,image/heic,application/pdf,text/plain

# ── SSE (Server-Sent Events) ──────────────────────────────────
SSE_KEEPALIVE_SECONDS=30        # intervalo de ping keep-alive
SSE_RECONNECT_WINDOW_SECONDS=30 # ventana para re-emitir eventos perdidos (Last-Event-ID)

# ── SLA DEFAULTS (horas) ─────────────────────────────────────
SLA_DEFAULT_CRITICAL_HOURS=4
SLA_DEFAULT_HIGH_HOURS=8
SLA_DEFAULT_MEDIUM_HOURS=24
SLA_DEFAULT_LOW_HOURS=72

# ── MINIMAX (AI assistant) ────────────────────────────────────
MINIMAX_API_KEY=CHANGE_ME
MINIMAX_API_URL=https://api.minimax.chat/v1/text/chatcompletion_v2
MINIMAX_MODEL=abab6.5s-chat      # modelo gratuito de Minimax
MINIMAX_TIMEOUT_SECONDS=10
AI_ENABLED=true                  # false para deshabilitar sin romper código

# ── FRONTEND ─────────────────────────────────────────────────
# Estas variables se usan en la build de Angular (environment.ts)
# No van en este .env — ver src/ui/src/environments/
ANGULAR_API_URL=http://localhost:8000/api/v1
ANGULAR_SSE_URL=http://localhost:8000/api/v1/events
